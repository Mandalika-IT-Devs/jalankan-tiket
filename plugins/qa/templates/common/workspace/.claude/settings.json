{
  "extraKnownMarketplaces": {
    "jalankan-tiket": {
      "source": { "source": "github", "repo": "Mandalika-IT-Devs/jalankan-tiket" },
      "autoUpdate": true
    }
  },
  "enabledPlugins": {
    "qa@jalankan-tiket": true
  },
  "permissions": {
    "allow": [
      "Bash(npx playwright test *)",
      "Bash(npx playwright show-report *)",
      "Bash(gh repo view *)",
      "Bash(gh auth status *)",
      "Bash(sleep *)"
    ],
    "deny": [
      "Read(./**/.env.local)",
      "Read(./**/.auth/**)",
      "Bash(*.env.local*)",
      "Bash(gh issue create *)",
      "Bash(gh issue comment *)",
      "Bash(gh issue edit *)",
      "Bash(gh issue close *)",
      "Bash(gh pr create *)",
      "Bash(gh pr comment *)",
      "Bash(gh pr review *)",
      "Bash(gh pr edit *)",
      "Bash(gh pr merge *)",
      "Bash(gh pr close *)",
      "Bash(gh api *)",
      "Bash(gh repo edit *)",
      "Bash(gh repo delete *)",
      "Bash(gh auth login *)",
      "Bash(gh auth logout *)",
      "Bash(gh auth switch *)",
      "Bash(gh auth refresh *)",
      "Bash(gh auth token *)",
      "Bash(git push --force *)",
      "Bash(git push -f *)",
      "Bash(git reset --hard *)"
    ]
  }
}
